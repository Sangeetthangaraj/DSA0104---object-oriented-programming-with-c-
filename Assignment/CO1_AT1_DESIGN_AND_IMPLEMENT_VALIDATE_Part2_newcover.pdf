BT 1 0 0 1 0 44.6 Tm /F3 7 Tf 8.6 TL (namespace proc {) Tj T* (long long balance = 10000;            // global: any function may change it) Tj T* (long long minBalance = 5000;          // rule value stored separately) Tj T* (bool canTravel\(long long f\) { return balance - f >= minBalance; }) Tj T* (void deduct\(long long f\)    { if \(canTravel\(f\)\) balance -= f; }) Tj T* (}) Tj T* ET
