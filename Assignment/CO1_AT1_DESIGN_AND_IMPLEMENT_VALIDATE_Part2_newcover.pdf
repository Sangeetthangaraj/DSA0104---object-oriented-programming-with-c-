BT 1 0 0 1 0 414.4 Tm /F3 7 Tf 8.6 TL (// metro_v1.hpp - original design \(3 zones, bool peak, switch on zone\)) Tj T* (#pragma once) Tj T* (#include "smartcard.hpp") Tj T*  T* (enum class Zone { Inner, Middle, Outer };) Tj T* (enum class Category { Adult, Student, Senior };) Tj T*  T* (constexpr long long BASE_PAISE[] = {1000, 2000, 3000};   // Rs 10, 20, 30 \(one place only\)) Tj T* (constexpr int PEAK_SURCHARGE_PERCENT = 20;) Tj T* (constexpr int CONCESSION_PERCENT     = 50;) Tj T* (constexpr int PEAK_AM_START = 8 * 60,  PEAK_AM_END = 10 * 60;   // [08:00, 10:00\)) Tj T* (constexpr int PEAK_PM_START = 17 * 60, PEAK_PM_END = 20 * 60;   // [17:00, 20:00\)) Tj T*  T* (// half-open intervals: 10:00 and 20:00 are OFF-peak, 08:00 and 17:00 are peak) Tj T* (constexpr bool isPeak\(int hour, int minute = 0\)) Tj T* ({) Tj T* (    const int m = hour * 60 + minute;) Tj T* (    return \(m >= PEAK_AM_START && m < PEAK_AM_END\) ||) Tj T* (           \(m >= PEAK_PM_START && m < PEAK_PM_END\);) Tj T* (}) Tj T*  T* (// integer percentage, rounded half-up: no floating point, no lost paisa) Tj T* (constexpr long long percentOf\(long long amount, int percent\)) Tj T* ({) Tj T* (    return \(amount * percent + 50\) / 100;) Tj T* (}) Tj T*  T* (inline bool zoneFromInt\(int n, Zone& z\)) Tj T* ({) Tj T* (    switch \(n\) {) Tj T* (        case 0: z = Zone::Inner;  return true;) Tj T* (        case 1: z = Zone::Middle; return true;) Tj T* (        case 2: z = Zone::Outer;  return true;) Tj T* (        default: return false;                  // unknown zone rejected) Tj T* (    }) Tj T* (}) Tj T*  T* (inline long long fare\(Zone z, bool peak, Category c = Category::Adult\)) Tj T* ({) Tj T* (    long long base = 0;) Tj T* (    switch \(z\) {) Tj T* (        case Zone::Inner:  base = BASE_PAISE[0]; break;) Tj T* (        case Zone::Middle: base = BASE_PAISE[1]; break;) Tj T* (        case Zone::Outer:  base = BASE_PAISE[2]; break;) Tj T* (    }) Tj T* (    long long f = peak ? base + percentOf\(base, PEAK_SURCHARGE_PERCENT\) : base;) Tj T* (    if \(c != Category::Adult\) f -= percentOf\(f, CONCESSION_PERCENT\);) Tj T* (    return f;) Tj T* (}) Tj T* ET
