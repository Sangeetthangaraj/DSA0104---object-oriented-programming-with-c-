BT 1 0 0 1 0 560.6 Tm /F3 7 Tf 8.6 TL (// metro_v2.hpp - adapted design: 4 zones, weekend discount, monthly pass) Tj T* (// SmartCard \(smartcard.hpp\) is RETAINED unchanged; fare logic MODIFIED; Pass class ADDED.) Tj T* (#pragma once) Tj T* (#include <cstddef>) Tj T* (#include "smartcard.hpp") Tj T*  T* (namespace v2 {) Tj T*  T* (enum class Zone     { Inner, Middle, Outer, Airport };      // new value appended at the end) Tj T* (enum class Category { Adult, Student, Senior };) Tj T* (enum class Tariff   { Standard, Peak, Weekend };            // replaces bool peak: 3 mutually exclusive states) Tj T*  T* (constexpr std::size_t ZONE_COUNT = 4;) Tj T* (constexpr long long BASE_PAISE[ZONE_COUNT] = {1000, 2000, 3000, 6000};  // Airport = Rs 60) Tj T* (static_assert\(static_cast<std::size_t>\(Zone::Airport\) + 1 == ZONE_COUNT, "fare table must cover every zone"\);) Tj T*  T* (constexpr int PEAK_SURCHARGE_PERCENT   = 20;) Tj T* (constexpr int WEEKEND_DISCOUNT_PERCENT = 10;) Tj T* (constexpr int CONCESSION_PERCENT       = 50;) Tj T*  T* (constexpr bool isPeakTime\(int hour, int minute = 0\)) Tj T* ({) Tj T* (    const int m = hour * 60 + minute;) Tj T* (    return \(m >= 8 * 60 && m < 10 * 60\) || \(m >= 17 * 60 && m < 20 * 60\);) Tj T* (}) Tj T* (constexpr long long percentOf\(long long amount, int percent\) { return \(amount * percent + 50\) / 100; }) Tj T*  T* (// weekend wins: the 10% discount and the 20% surcharge are never combined) Tj T* (constexpr Tariff tariffFor\(bool weekend, int hour, int minute = 0\)) Tj T* ({) Tj T* (    return weekend ? Tariff::Weekend : \(isPeakTime\(hour, minute\) ? Tariff::Peak : Tariff::Standard\);) Tj T* (}) Tj T*  T* (inline long long fare\(Zone z, Tariff t, Category c = Category::Adult\)) Tj T* ({) Tj T* (    const long long base = BASE_PAISE[static_cast<std::size_t>\(z\)];       // table indexed by zone) Tj T* (    long long f = base;) Tj T* (    switch \(t\) {) Tj T* (        case Tariff::Standard: break;) Tj T* (        case Tariff::Peak:     f = base + percentOf\(base, PEAK_SURCHARGE_PERCENT\); break;) Tj T* (        case Tariff::Weekend:  f = base - percentOf\(base, WEEKEND_DISCOUNT_PERCENT\); break;) Tj T* (    }) Tj T* (    if \(c != Category::Adult\) f -= percentOf\(f, CONCESSION_PERCENT\);) Tj T* (    return f;) Tj T* (}) Tj T*  T* (// Monthly pass: unlimited journeys whose farthest zone is one of two chosen zones, in one month) Tj T* (class Pass {) Tj T* (public:) Tj T* (    Pass\(Zone a, Zone b, int yyyymm\) : a_{a}, b_{b}, month_{yyyymm} {}) Tj T* (    bool covers\(Zone z, int yyyymm\) const { return yyyymm == month_ && \(z == a_ || z == b_\); }) Tj T* (private:) Tj T* (    Zone a_, b_;) Tj T* (    int  month_;) Tj T* (};) Tj T*  T* (struct Result { bool ok; long long charged; };) Tj T*  T* (inline Result travel\(SmartCard& card, const Pass* pass, Zone z, Tariff t, Category c, int yyyymm\)) Tj T* ({) Tj T* (    if \(pass && pass->covers\(z, yyyymm\)\) return {true, 0};   // covered journey: nothing deducted) Tj T* (    const long long f = fare\(z, t, c\);) Tj T* (    return {card.deduct\(f\), f};) Tj T* (}) Tj T*  T* (} // namespace v2) Tj T* ET
