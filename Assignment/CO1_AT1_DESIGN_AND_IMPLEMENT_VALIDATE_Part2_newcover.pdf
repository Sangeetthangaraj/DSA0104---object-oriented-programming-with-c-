BT 1 0 0 1 0 259.6 Tm /F3 7 Tf 8.6 TL (// smartcard.hpp - SmartCard class \(kept UNCHANGED between design v1 and v2\)) Tj T* (#pragma once) Tj T*  T* (constexpr long long MIN_BALANCE_PAISE = 5000;   // Rs 50 must remain on the card) Tj T*  T* (class SmartCard {) Tj T* (public:) Tj T* (    explicit SmartCard\(long long openingPaise = 0\)) Tj T* (        : balance_{openingPaise > 0 ? openingPaise : 0} {}) Tj T*  T* (    long long balance\(\) const { return balance_; }) Tj T*  T* (    bool recharge\(long long paise\)               // negative / zero recharge rejected) Tj T* (    {) Tj T* (        if \(paise <= 0\) return false;) Tj T* (        balance_ += paise;) Tj T* (        return true;) Tj T* (    }) Tj T* (    bool canTravel\(long long fare\) const         // rule: balance after fare >= Rs 50) Tj T* (    {) Tj T* (        return fare >= 0 && balance_ - fare >= MIN_BALANCE_PAISE;) Tj T* (    }) Tj T* (    bool deduct\(long long fare\)                  // the ONLY way balance goes down) Tj T* (    {) Tj T* (        if \(!canTravel\(fare\)\) return false;) Tj T* (        balance_ -= fare;) Tj T* (        return true;) Tj T* (    }) Tj T* (private:) Tj T* (    long long balance_;                          // integer paise, never public) Tj T* (};) Tj T* ET
