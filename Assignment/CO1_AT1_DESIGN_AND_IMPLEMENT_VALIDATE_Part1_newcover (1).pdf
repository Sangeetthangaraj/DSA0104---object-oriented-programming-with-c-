BT 1 0 0 1 0 491.8 Tm /F3 7 Tf 8.6 TL (// Task 6 - Complete the Code \(switch on zone, integer paise\) + 10:00 / 20:00 boundary check) Tj T* (#include <iomanip>) Tj T* (#include <iostream>) Tj T*  T* (enum class Zone { Inner, Middle, Outer };) Tj T*  T* (constexpr int BASE_PAISE[] = {1000, 2000, 3000}; // Rs 10, Rs 20, Rs 30) Tj T* (constexpr int PEAK_SURCHARGE_PERCENT = 20;) Tj T* (constexpr long long MIN_BALANCE_PAISE = 5000; // Rs 50 must remain on the card) Tj T*  T* (long long fare\(Zone z, bool peak\)) Tj T* ({) Tj T* (    long long base = 0;) Tj T* (    switch \(z\) {                                   // TODO 1) Tj T* (        case Zone::Inner:  base = BASE_PAISE[0]; break;) Tj T* (        case Zone::Middle: base = BASE_PAISE[1]; break;) Tj T* (        case Zone::Outer:  base = BASE_PAISE[2]; break;) Tj T* (    }) Tj T* (    if \(peak\) base += base * PEAK_SURCHARGE_PERCENT / 100;   // integer arithmetic only) Tj T* (    return base;) Tj T* (}) Tj T*  T* (bool canTravel\(long long balance, long long f\)) Tj T* ({) Tj T* (    return balance - f >= MIN_BALANCE_PAISE;       // TODO 2) Tj T* (}) Tj T*  T* (constexpr bool isPeak\(int hour, int minute\)) Tj T* ({) Tj T* (    const int m = hour * 60 + minute;) Tj T* (    return \(m >= 8 * 60 && m < 10 * 60\) || \(m >= 17 * 60 && m < 20 * 60\);) Tj T* (}) Tj T*  T* (int main\(\)) Tj T* ({) Tj T* (    long long balance = 10000; // Rs 100.00 in paise) Tj T* (    struct Trip { Zone zone; bool peak; };) Tj T* (    Trip trips[] = {{Zone::Inner, false}, {Zone::Outer, true}, {Zone::Middle, false}};) Tj T* (    for \(const Trip& t : trips\) {) Tj T* (        long long f = fare\(t.zone, t.peak\);) Tj T* (        if \(canTravel\(balance, f\)\) {) Tj T* (            balance -= f;) Tj T* (            std::cout << "Fare Rs " << f / 100 << '.' << std::setw\(2\)) Tj T* (                      << std::setfill\('0'\) << f % 100 << std::setfill\(' '\);) Tj T* (        } else {) Tj T* (            std::cout << "Denied \(low balance\)";) Tj T* (        }) Tj T* (        std::cout << " balance Rs " << balance / 100 << '\\n';) Tj T* (    }) Tj T*  T* (    std::cout << "\\n--- boundary check: Inner zone, balance Rs 500 each time ---\\n";) Tj T* (    struct T { int h, m; };) Tj T* (    for \(T t : {T{7,59}, T{8,0}, T{9,59}, T{10,0}, T{16,59}, T{17,0}, T{19,59}, T{20,0}}\) {) Tj T* (        bool pk = isPeak\(t.h, t.m\);) Tj T* (        std::cout << std::setfill\('0'\) << std::setw\(2\) << t.h << ':' << std::setw\(2\) << t.m) Tj T* (                  << std::setfill\(' '\) << "  peak=" << pk << "  fare=" << fare\(Zone::Inner, pk\) << " paise\\n";) Tj T* (    }) Tj T* (}) Tj T* ET
